# LLM Provider Configuration
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_PROVIDER=nvidia
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
FAST_MODEL=meta/llama-3.2-11b-vision-instruct
REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional Legacy LLM Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search API (Optional - ONE of the following)
# If none are set, the app falls back to FREE DuckDuckGo search (no key needed)
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_KEY=

# Browser Settings
# Mode: visible (recommended, opens window) | headless (background) | cdp (connect to existing Chrome)
BROWSER_MODE=visible
# Type: msedge (default, pre-installed on Windows) | chrome | chromium | firefox | webkit
# Uses your installed browser — NO bundled Chromium download required.
BROWSER_TYPE=msedge
HEADLESS=false
KEEP_BROWSER_OPEN=false

# Connection Mode: playwright (dedicated launched browser) | cdp (connect to existing Chrome)
BROWSER_CONNECTION_MODE=playwright
CDP_ENDPOINT=http://127.0.0.1:9222

# Safety Guardrails
BLOCK_PURCHASE_URLS=checkout,payment,cart/confirm,order/place

# Storage Backend: sqlite | supabase | dual
STORAGE_BACKEND=dual
DB_PATH=data/experiments.db
LOG_DIR=logs/runs

# Supabase Storage (Optional cloud storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
