# LLM Provider
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_PROVIDER=nvidia
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Optional legacy keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search API (ONE of the following)
SERPAPI_KEY=8445f6dcc6ec8a127986f14487e8f7849b78146022f6895c040040215b115291
GOOGLE_CSE_KEY=your_key_here
GOOGLE_CSE_CX=your_cx_id_here
BING_SEARCH_KEY=your_key_here

# Browser (chromium | msedge | chrome | firefox | webkit)
HEADLESS=false
BROWSER_TYPE=chromium

# Safety
BLOCK_PURCHASE_URLS=checkout,payment,cart/confirm,order/place

# Storage Backend: sqlite | supabase | dual
STORAGE_BACKEND=dual
DB_PATH=data/experiments.db
LOG_DIR=logs/runs

# Supabase Storage (Optional cloud storage)
SUPABASE_URL=https://your-project-id.supabase.co
