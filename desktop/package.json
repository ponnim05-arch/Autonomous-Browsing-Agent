{
  "name": "autonomous-browser-agent-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop app for the Autonomous Browser Agent",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ponnim05.autonomousbrowseragent",
    "productName": "Autonomous Browser Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/agent-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../backend/build/ms-playwright",
        "to": "ms-playwright"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
